{
  "name": "magic-reading",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "validate-content": "node --disable-warning=ExperimentalWarning scripts/validate-content.ts",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "audio:generate": "node --disable-warning=ExperimentalWarning scripts/make-audio.ts",
    "check-prod-build": "node --disable-warning=ExperimentalWarning scripts/check-prod-build.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-magic-reading 'vitest run --config vitest.rules.config.ts'",
    "deploy:rules": "firebase deploy --only firestore:rules",
    "bundle-report": "node --disable-warning=ExperimentalWarning scripts/bundle-report.ts",
    "review-list": "node --disable-warning=ExperimentalWarning scripts/review-list.ts"
  },
  "dependencies": {
    "@tsparticles/confetti": "^4.4.0",
    "firebase": "^13.1.0",
    "howler": "^2.2.4",
    "motion": "^14.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@playwright/test": "1.64.1",
    "@types/howler": "^2.2.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-tools": "^15.34.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
